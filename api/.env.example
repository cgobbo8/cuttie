# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=         # Generate with: node ace generate:key
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=database

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional, unused by the desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set by the launcher (scripts/dev.mjs / desktop app) — no need to edit:
# CUTTIE_DATA_DIR=         data directory shared with the worker (default: <repo>/.data)
# WORKER_URL=              worker's local HTTP server (default http://127.0.0.1:3334)
# CUTTIE_INTERNAL_SECRET=  shared secret between API and worker
# CUTTIE_AUTO_LOGIN=       sign in automatically as the local user (default true)
# FRONTEND_DIST=           serve the built frontend from the API (packaged app)
