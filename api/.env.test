# Loaded on top of .env by `node ace test`
PORT=3335
SESSION_DRIVER=memory
# Tests exercise the real login flow, not the desktop auto-login
CUTTIE_AUTO_LOGIN=false
# Throwaway data dir (DB + storage), migrated by tests/bootstrap.ts
CUTTIE_DATA_DIR=tmp/test-data
# No worker in tests: calls to it fail at once instead of reaching a dev one
WORKER_URL=http://127.0.0.1:9
