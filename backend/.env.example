# Optional in dev: API keys can also be saved from the app's Settings page
# (<data dir>/settings.json takes precedence over these variables).
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# Twitch (chat download)
TWITCH_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko

# Set by the launcher (scripts/dev.mjs / desktop app) — no need to edit:
# CUTTIE_DATA_DIR=     data directory shared with the API (default: <repo>/.data)
# CUTTIE_API_URL=      API base URL the worker reports progress to
# CUTTIE_INTERNAL_SECRET=  shared secret between API and worker
# CUTTIE_WORKER_PORT=  port of the worker's local HTTP server (default 3334)
