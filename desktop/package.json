{
  "name": "cuttie",
  "productName": "Cuttie",
  "version": "0.1.3",
  "description": "Les meilleurs moments de tes lives Twitch, prêts à poster.",
  "author": "Cuttie",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "stage": "node scripts/stage.mjs",
    "pack": "node scripts/stage.mjs && electron-builder --dir --publish never",
    "dist": "node scripts/stage.mjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.cuttie.desktop",
    "productName": "Cuttie",
    "copyright": "Cuttie",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "setup.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/app",
        "to": "app",
        "filter": ["**/*"]
      },
      {
        "from": "stage/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "Cuttie-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cuttie"
    },
    "mac": {
      "target": "dir",
      "icon": "resources/icon.png",
      "identity": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cgobbo8",
        "repo": "cuttie",
        "releaseType": "release"
      }
    ]
  }
}
